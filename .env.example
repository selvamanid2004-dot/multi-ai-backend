# ==============================================================================
# Multi-Agent AI Research & Decision System - Environment Configuration
# ==============================================================================

# Server Settings
PROJECT_NAME="Multi-Agent AI Research & Decision System"
VERSION="1.0.0"
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Database (Default: Async SQLite)
DATABASE_URL="sqlite+aiosqlite:///./multi_agent.db"

# AI Provider Configuration ('auto', 'openai', 'gemini', or 'mock')
# In 'auto' mode, it automatically uses OpenAI if key is present, otherwise Gemini, otherwise Mock.
DEFAULT_PROVIDER="auto"

# OpenAI Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Web Research Settings
ENABLE_LIVE_SEARCH=true
SEARCH_MAX_RESULTS=5

# Human-In-The-Loop Review Gate (true = pauses at verification for review, false = autonomous)
REQUIRE_HUMAN_APPROVAL=true
